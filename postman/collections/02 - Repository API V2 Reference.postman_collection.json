  "item": [
    {
      "name": "Repositories and Folders",
      "description": "Laserfiche Cloud Repository API V2 examples.",
      "item": [
        {
          "name": "List repositories",
          "request": {
            "method": "GET",
            "url": "{{apiBaseUrl}}/Repositories",
            "description": "Discover repository IDs visible to your Cloud identity.",
            "header": []
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Expected HTTP status', () => pm.expect([200]).to.include(pm.response.code));",
                  "if (![200].includes(pm.response.code)) pm.execution.setNextRequest(null);",
                  "else {",
                  "",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "List folder children",
          "request": {
            "method": "GET",
            "url": "{{apiBaseUrl}}/Repositories/{{repo}}/Entries/{{entryId}}/Folder/Children",
            "description": "\n\nRequires an authorized repository read token and appropriate repository permissions. https://developer.laserfiche.com/docs/api/repository-api-reference/",
            "header": []
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (!/^\\d+$/.test(pm.variables.get('entryId') || '')) { console.error('Set entryId to a numeric ID.'); pm.execution.skipRequest(); }"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Expected HTTP status', () => pm.expect([200]).to.include(pm.response.code));",
                  "if (![200].includes(pm.response.code)) pm.execution.setNextRequest(null);",
                  "else {",
                  "",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Create test child folder",
          "request": {
            "method": "POST",
            "url": "{{apiBaseUrl}}/Repositories/{{repo}}/Entries/{{testFolderId}}/Folder/Children",
            "description": "\n\nRequires repository.Write and appropriate repository permissions. https://developer.laserfiche.com/docs/guides/documents-and-folders/guide_creating-folders/",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"entryType\":\"Folder\",\"name\":\"{{newFolderName}}\",\"autoRename\":false}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (!/^\\d+$/.test(pm.variables.get('testFolderId') || '')) { console.error('Set testFolderId to a numeric ID.'); pm.execution.skipRequest(); }",
                  "if (pm.environment.get('allowWrites') !== 'true') { console.error('Set allowWrites=true in the test environment.'); pm.execution.skipRequest(); }",
                  "pm.variables.set('newFolderName', 'FicheBait API Test ' + new Date().toISOString().replace(/[:.]/g, '-'));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Expected HTTP status', () => pm.expect([201]).to.include(pm.response.code));",
                  "if (![201].includes(pm.response.code)) pm.execution.setNextRequest(null);",
                  "else {",
                  "pm.test('Created under the configured test folder', () => pm.expect(String(pm.response.json().parentId)).to.eql(String(pm.variables.get('testFolderId'))));",
                  "}"
                ]
              }
            }
          ]
        }
      ]
    },
