      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "const e = pm.environment;",
          "const endpoint = e.get('apiBaseUrl') || '';",
          "if (e.get('deployment') !== 'cloud' || !/^https:\\/\\/api\\.(laserfiche\\.com|laserfiche\\.ca|eu\\.laserfiche\\.com)\\/repository\\/v2$/.test(endpoint) || (pm.info.requestName !== 'List repositories' && !/^r-[a-z0-9]+$/i.test(e.get('repositoryId') || '')) || !e.get('accessToken')) {",
          "  console.error('Select a configured Cloud environment with a local access token.');",
          "  pm.execution.skipRequest();",
          "} else {",
          "  pm.variables.set('apiBaseUrl', endpoint);",
          "  pm.variables.set('repo', e.get('repositoryId'));",
          "  pm.variables.set('accessToken', e.get('accessToken'));",
          "}"
